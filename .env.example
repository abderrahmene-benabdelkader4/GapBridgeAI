# Normally you do NOT need this file: enter everything in the app under Settings.
# These variables are only useful for developers and for running the tests.
LLM_PROVIDER=gemini            # gemini | openai | groq | ollama
GEMINI_API_KEY=                # free key: aistudio.google.com/apikey
GEMINI_MODEL=                  # leave empty: the app picks the free model with the biggest allowance
OPENAI_BASE_URL=               # e.g. https://api.mistral.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=mistral-small-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
OPENALEX_MAILTO=you@university.edu
EMBED_MODEL=
# where projects and settings are stored (default: ~/GapFinder)
# GAPFINDER_HOME=
